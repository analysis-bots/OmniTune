[Refinement] k=0 sql=WITH ranked AS (
  SELECT *,
    PERCENT_RANK() OVER (...) AS pr
  FROM TexasTribune
  WHERE HRSWKD > 30
    AND ANNUAL > 50000
)
SELECT ETHNICITY,
  AVG(ANNUAL) AS avg_annual,
  SUM(MONTHLY) AS total_monthly
FROM ranked
WHERE pr >= 0.35 AND pr <= 0.90
GROUP BY ETHNICITY; agg=0.29 d=0.16 acc_tokens_total=1000

